# Copier ce fichier en ".env" pour travailler en local.
# Sur Vercel, ces valeurs se saisissent dans Settings > Environment Variables.

# Supabase : Project Settings > API (ou "API Keys")
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Notion : clé secrète de l'intégration interne (https://www.notion.so/profile/integrations)
NOTION_TOKEN=

# Seule adresse e-mail autorisée à utiliser l'export Notion et les aperçus de liens
ALLOWED_EMAIL=
