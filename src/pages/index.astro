---
import App from '../components/App';
// Polices de la charte, hébergées dans l'app (sous-ensemble latin, graisses utiles seulement).
import '@fontsource/bricolage-grotesque/latin-600.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '@fontsource/figtree/latin-400.css';
import '@fontsource/figtree/latin-600.css';
import '@fontsource/figtree/latin-700.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>Ject</title>
    <meta name="description" content="Ject : ton inbox pour noter vite idées, listes et envies." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Emoji du contenu (aires, illustrations) : même rendu sur tous les appareils (décisions 25, 30). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#F0ECE7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1614" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Applique le thème choisi avant l'affichage (évite un flash blanc en mode sombre).
      try {
        const t = localStorage.getItem('ject-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
          m.removeAttribute('media');
          m.setAttribute('content', dark ? '#1A1614' : '#F0ECE7');
        });
      } catch {}
    </script>
  </head>
  <body>
    <App client:only="react" />
    <script is:inline>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>
